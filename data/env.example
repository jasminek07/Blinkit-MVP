# =============================================================================
# STREAMLIT CLOUD SECRETS DASHBOARD (Copy-Paste TOML Format for share.streamlit.io)
# =============================================================================
# Streamlit Cloud requires valid TOML syntax. Strings MUST be enclosed in double quotes!
# Copy the exact line below into App Settings -> Secrets in Streamlit Cloud:

GROQ_API_KEY = "gsk_your_groq_api_key_here"

# =============================================================================
# LOCAL .env FILE FORMAT (Optional for local testing)
# =============================================================================
# GROQ_API_KEY="gsk_your_groq_api_key_here"
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true
