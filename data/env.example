# -----------------------------------------------------------------------------
# Blinkit Contextual Recs Engine - Environment Configuration
# -----------------------------------------------------------------------------

# 1. API Keys (Required for live LLM features)
GROQ_API_KEY=your_groq_api_key_here

# 2. Streamlit Local Runner Customizations (Optional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
PYTHONPATH="."

# 3. Deployment Notes for Streamlit Community Cloud:
# --------------------------------------------------
# When deploying to Streamlit Community Cloud, do NOT upload or commit this .env file.
# Instead, add the keys directly in the Streamlit Cloud dashboard under:
# App Settings -> Secrets, using the following format:
#
# GROQ_API_KEY = "your_groq_api_key_here"
# -----------------------------------------------------------------------------
